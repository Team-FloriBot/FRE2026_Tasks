  <version>0.0.1</version>
  <description>ROS 2 interfaces for FRE2026 navigation task control.</description>

  <maintainer email="tzimmerman@stud.hs-heilbronn.de">FRE2026 Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

