<?xml version="1.0"?>
<package format="3">
  <name>fre2026_detection_client</name>
  <version>0.0.1</version>
  <description>Shared ROS 2 client adapter for the FRE2026 detector service API.</description>

  <maintainer email="fre2026@todo.todo">FRE2026 Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>fre2026_detection_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>ros2_detection_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
